# 천하 자체 서버 설정(Manus 없이). 실제 값은 이 파일에 넣지 말고 .env 또는 배포 서비스의 환경 변수에 넣는다.
# MySQL 주소. 클라우드 MySQL의 ?ssl-mode=REQUIRED 도 그대로 넣으면 된다.
DATABASE_URL=mysql://user:password@host:3306/cheonha
# 세션 서명 키: 32자 이상 무작위 문자열 (예: openssl rand -hex 32)
JWT_SECRET=
# 운영자(관리자 권한)로 쓸 아이디, 쉼표로 구분
ADMIN_NAMES=
# 비밀번호를 잊었을 때만 "아이디:새비밀번호" (적용 뒤 지우기)
PASSWORD_RESET=
